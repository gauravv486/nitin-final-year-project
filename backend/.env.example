# CA-OS backend environment
#
# Copy this file to `.env` and edit. Only DATABASE_URL genuinely needs your
# attention; everything else has a working default.
#
#   cp .env.example .env          (Git Bash)
#   copy .env.example .env        (cmd)
#
# Full walkthrough for the database: see README.md -> "Connecting PostgreSQL".

# =========================================================== DATABASE ======
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# After a default Windows install of PostgreSQL, USER is `postgres` and the
# password is whatever you typed in the installer. Create the database first:
#
#   psql -U postgres -c "CREATE DATABASE ca_os;"
#
# A plain `postgresql://` prefix is fine - the app rewrites it to the psycopg 3
# driver automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ca_os

# Print every SQL statement to the console. Handy for one debugging session,
# unbearable as a permanent setting.
DB_ECHO=false

# ============================================================= RUNTIME =====
ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Comma-separated. The Next.js frontend runs on 3000.
CORS_ORIGINS=http://localhost:3000

# ============================================================ SECURITY =====
# Leave blank in development and a throwaway key is generated at each boot -
# which means every restart invalidates existing logins. Set a real value to
# stop that:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Required in production; the app refuses to start without it.
JWT_SECRET=

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ============================================================= STORAGE =====
MAX_UPLOAD_MB=25

# ================================================================== ML =====
# Predictions below this confidence are never applied automatically - they are
# queued for a human. The classifier's probabilities are calibrated, so 0.90
# really does mean "right about 90% of the time at this threshold".
LEDGER_AUTO_APPLY_FLOOR=0.90

# ================================================================= LLM =====
# Only the drafting features (notice replies, engagement letters, board
# minutes) use a language model. Everything else is classical ML.
#
#   ollama    - local, free, private, offline. Default. Install from
#               https://ollama.com then:  ollama pull qwen3:4b
#   anthropic - hosted. Better drafts, costs money, and client financial data
#               leaves this machine. Needs ANTHROPIC_API_KEY.
#   stub      - replies "not configured" rather than inventing a draft.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ========================================================== EMBEDDINGS =====
# Phase 6 (case-law search) only. Needs: pip install -r requirements-ml.txt
# EMBEDDING_DIM must match both the model's output size and the stored column.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Leave this false. pgvector ships no Windows binaries and compiling it needs
# the Visual Studio C++ toolchain, so the default stores embeddings as a float
# array and ranks them in NumPy - same answers, a few milliseconds slower, and
# nothing else in the project is affected.
#
# This decides the column TYPE, so changing it after the first migration
# requires regenerating the migration. See README.md step 4.
PGVECTOR_ENABLED=false
